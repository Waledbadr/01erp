# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server configuration
PORT=3000
NODE_ENV="development"

# Database Configuration (PostgreSQL / Cloud SQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saudi_erp"

# Identity persistence: when DATABASE_URL is set, users, companies, memberships and
# sessions are stored in PostgreSQL (tables are created automatically on first request,
# or run `npm run db:migrate`). Operational data (journals, invoices, stock...) is still in memory.
# ERP_PERSISTENCE="off"   # force in-memory mode even when DATABASE_URL is set

# Demo company/users with a PUBLISHED password. Default: on without a database, off with one.
# SEED_DEMO_DATA="false"

# Platform super admin created/updated by `npm run db:migrate` (password >= 12 chars).
# PLATFORM_ADMIN_EMAIL=""
# PLATFORM_ADMIN_PASSWORD=""

# Payment gateway webhook (POST /api/v1/billing/webhook). Required: without it the webhook
# answers 503. The gateway must send header x-webhook-signature = hex HMAC-SHA256(raw body).
# BILLING_WEBHOOK_SECRET=""

# Integration tests only: a DISPOSABLE database (its public schema is dropped).
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp_test"

# Authentication & Security
JWT_SECRET="super-secret-jwt-key-min-32-chars-change-in-production"

# ZATCA Phase 2 Environment ('sandbox' | 'simulation' | 'production')
ZATCA_ENV="simulation"

# Logging Level ('debug' | 'info' | 'warn' | 'error')
LOG_LEVEL="info"

